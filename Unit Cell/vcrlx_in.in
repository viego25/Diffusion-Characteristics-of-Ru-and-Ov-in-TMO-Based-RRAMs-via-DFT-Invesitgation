&CONTROL
  calculation   = "vc-relax"
  forc_conv_thr = 3.88938d-4
  etot_conv_thr = 3.88938d-8
  outdir = './out/'
  prefix = 'aiida'
  pseudo_dir = './pseudo/'
  verbosity = 'high'
/

&SYSTEM
    a                         =  5.1507
    b                         =  5.2028
    c                         =  5.3156
    cosac                     = -0.15981227219
    ecutrho                   =  520
    ecutwfc                   =  52
    ibrav                     = -12
    nat                       = 12
    ntyp                      = 2
	nosym                     = .true.
    occupations               = "fixed"
/

&ELECTRONS
  conv_thr =  1d-8
  electron_maxstep = 200
  mixing_beta =  0.4
/

&IONS
    ion_dynamics = "bfgs"
/

&CELL
    cell_dofree = "ibrav"
    cell_dynamics = "bfgs"
    press = 0.0
    press_conv_thr = 0.5
/

